---
import { SUPPORTED_LOCALES } from "@content/i18n/locale";
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import Icon from "@components/ui/Icon.astro";

Astro.response.status = 404;

const locale = SUPPORTED_LOCALES.EN;
---

<BaseLayout
  locale={locale}
  pageTitle="Page not found | Renaud Lapoele"
  pageDescription="Page not found. Return to Renaud Lapoele's English or French resume landing page."
  navItemUrlPrefix="/en"
>
  <section id="hero" class="l-section min-h-svh">
    <Container class="pbs-24 pbe-16 grid place-items-center text-center">
      <div class="max-w-2xl space-y-8">
        <p class="text-xl font-semibold dark:font-medium uppercase tracking-wider text-accent-primary">
          404
        </p>

        <div class="space-y-4">
          <h1 class="text-5xl sm:text-6xl font-serif font-semibold leading-none text-ink-primary">
            Page not found
          </h1>
          <p class="mx-auto max-w-xl text-lg leading-relaxed text-ink-secondary">
            This link does not point to an available page. You can return to the resume in English or French.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
          <a class="c-button" href="/en">
            English resume
          </a>
          <a class="c-button c-button--secondary" href="/fr">
            <Icon class="size-4 stroke-2" type="language" isDecorative={true} />
            <span>CV en français</span>
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
