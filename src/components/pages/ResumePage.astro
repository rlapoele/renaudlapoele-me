---
import type { LocaleType } from "@content/i18n/locale";
import { getResumeData } from "@content/i18n/resume";
import { config } from "@content/config";
import { DOM_ELEM_IDS } from "@scripts/client/notificationManagement.ts";
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@sections/Hero/Hero.astro";
import CareerDetails from "@sections/CareerDetails/CareerDetails.astro";
import CareerOverview from "@sections/CareerOverview/CareerOverview.astro";
import Contact from "@sections/Contact/Contact.astro";
import Toasts from "@components/ui/Toasts.astro";

type Props = { locale: LocaleType; };

const { locale } = Astro.props as Props;
const resume = getResumeData(locale);
const { personal } = resume.data;
const {
  pageMetadata,
  hero,
  careerOverview,
  careerDetails,
  contact
} = resume.content;
const {sections} = resume.ui;
---
<BaseLayout locale={locale} pageTitle={pageMetadata.title} pageDescription={pageMetadata.description}>
  <Hero content={hero} data={config.sections.hero.links} ui={sections.hero} fullname={personal.fullName} config={config.sections.hero} />
  <CareerOverview class="mbe-18" content={careerOverview} contentLabels={sections.careerOverview}/>
  <CareerDetails content={careerDetails} contentLabels={sections.careerDetails}/>
  <Contact class="mbe-30" locale={locale} content={contact} contentLabels={sections.contact}/>
  <Toasts id={DOM_ELEM_IDS.TOAST_CONTAINER} placement="top-center"/>
</BaseLayout>
