---
import type { NavBarItemType } from "@content/config/Types";
import type { NavigationUIType, SettingsUIType } from "@content/i18n/resume/Types.ts";
import { SUPPORTED_LOCALES } from "@content/i18n/locale";
import { DOM_ELEMENT_IDS } from "@scripts/client/colorThemeManagement";
import Icon from "@components/ui/Icon.astro";

type Props = {
  locale: string;
  siteUrl: string;
  navItems: NavBarItemType[]
  navigation: NavigationUIType,
  settings: SettingsUIType
};
const {
  locale,
  siteUrl,
  navItems,
  navigation,
  settings
} = Astro.props as Props;
---
<header role="banner" class="c-page-header print:hidden">
  <div class="h-full flex flex-nowrap items-center justify-between gap-8 px-6">
    <a id="rl-site-link" href={siteUrl} class="uppercase text-normal font-bold c-text-link hidden xl:inline-block">RENAUDLAPOELE.ME</a>

    <button type="button" class="c-button c-button--icon -ms-2 xl:hidden" title={navigation.menuOpenSelectorLabel} aria-label={navigation.menuOpenSelectorLabel}><Icon isDecorative={true} type="bar3" class="size-4"/></button>

    <nav role="navigation" class="grow hidden xl:flex flex-nowrap items-center justify-center">
      <ul class="px-6 flex flex-nowrap gap-8 items-center justify-center">
        {navItems.map((item) => (
          <li>
            <a href={item.url} class="uppercase c-nav-link text-sm font-semibold dark:font-medium pbs-6 pbe-6 block">
              {navigation.navItems[item.key].label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button type="button" class="c-button c-button--icon -me-2 xl:hidden" title={settings.menuOpenSelectorLabel} aria-label={settings.menuOpenSelectorLabel}><Icon isDecorative={true} type="settings" class="size-4"/></button>

    <div class="xl:inline-flex hidden flex-nowrap items-center gap-4">
      <div class="inline-flex items-center">
        <a id="rl-language-selector" href={ locale === SUPPORTED_LOCALES.FR ? '/en' : '/fr'} class="c-button c-button--small" aria-label={settings.language.selectorLabel}>{settings.language.selectorLabel}</a>
      </div>
      <div class="inline-flex items-center gap-2">
        <button id={DOM_ELEMENT_IDS.COLOR_THEME_MANAGER_SELECTOR_SYSTEM} type="button" class="c-button c-button--icon" title={settings.colorTheme.osThemeSelectorTitle} aria-label={settings.colorTheme.osThemeSelectorTitle} aria-pressed="false" data-active-label={settings.colorTheme.osThemeSelectorActiveTitle}><Icon isDecorative={true} class="size-4" type="computer" /></button>
        <button id={DOM_ELEMENT_IDS.COLOR_THEME_SELECTOR_LIGHT} type="button" class="c-button c-button--icon" title={settings.colorTheme.lightThemeSelectorTitle} aria-label={settings.colorTheme.lightThemeSelectorTitle} aria-pressed="false" data-active-label={settings.colorTheme.lightThemeSelectorActiveTitle}><Icon isDecorative={true}  class="size-4" type="sun" /></button>
        <button id={DOM_ELEMENT_IDS.COLOR_THEME_SELECTOR_DARK} type="button" class="c-button c-button--icon" title={settings.colorTheme.darkThemeSelectorTitle} aria-label={settings.colorTheme.darkThemeSelectorTitle} aria-pressed="false" data-active-label={settings.colorTheme.darkThemeSelectorActiveTitle}><Icon isDecorative={true} class="size-4" type="moon" /></button>
      </div>
    </div>

  </div>
</header>

