---
import { combineCssClasses } from "@scripts/shared/combineCssClasses.ts";
import type {HTMLTag} from "astro/types";

type Props = {
  label: string;
  title: string;
  class?: string;
  isHeaderStatic?: boolean
  tag?: HTMLTag
  headingLabelTag?: HTMLTag
  headingTitleTag?: HTMLTag
};

const {
  class: className,
  label,
  title,
  isHeaderStatic = false,
  tag: SectionHeadingTagElement= "header",
  headingLabelTag: SectionHeadingLabelTagElement= "h3",
  headingTitleTag: SectionHeadingTitleTagElement= "h4"

} = Astro.props as Props;
const baseCssClasses = isHeaderStatic ? "c-section__heading" : "c-section__heading c-section__heading--dynamic";
const classes = combineCssClasses(baseCssClasses, className);
---
<SectionHeadingTagElement class={classes}>
  <SectionHeadingLabelTagElement class="c-section__heading__label">
    {label}
  </SectionHeadingLabelTagElement>
  <SectionHeadingTitleTagElement class="c-section__heading__title">{title}</SectionHeadingTitleTagElement>
</SectionHeadingTagElement>

