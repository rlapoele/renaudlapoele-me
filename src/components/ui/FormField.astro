---
import { combineCssClasses } from "@scripts/combineCssClasses.ts";
import Icon from "@components/ui/Icon.astro";

type FieldType = "input" | "textarea";

type InputType = "button"
  | "checkbox"
  | "color"
  | "date"
  | "datetime-local"
  | "email"
  | "file"
  | "hidden"
  | "image"
  | "month"
  | "number"
  | "password"
  | "radio"
  | "range"
  | "reset"
  | "search"
  | "submit"
  | "tel"
  | "text"
  | "time"
  | "url"
  | "week"
  | null
  | undefined;

type AttributesType = Record<string, unknown>;

type Props = {
  id: string;
  label: string;
  name: string;
  fieldType?: FieldType;
  inputType?: InputType;
  errorMessageId?: string;
  errorMessages?: string;
  required?: boolean;
  isHoneyPot?: boolean;
  rows?: number;
  autocomplete?: string;
  placeholder?: string;
  minlength?: number;
  maxlength?: number;
  class?: string;
  inputClass?: string;
  successIndicatorClass?: string;
  attributes?: AttributesType;
};

const {
  id,
  label,
  name,
  fieldType = "input",
  inputType = "text",
  errorMessageId,
  errorMessages,
  required = false,
  isHoneyPot = false,
  rows,
  class: className,
  inputClass,
  successIndicatorClass,
  ...attributes
} = Astro.props as Props;

const classes = combineCssClasses("c-form-field", className);
const inputClasses = combineCssClasses("c-form-field__input", inputClass);
const successIndicatorClasses = combineCssClasses(
  "c-form-field__success-indicator absolute right-2",
  fieldType === "textarea" ? "top-3" : "",
  successIndicatorClass,
);
let extendedFormElementAttributes: AttributesType = {};
let extendedFormFieldAttributes: AttributesType = {};

if (isHoneyPot) {
  extendedFormElementAttributes = {...attributes, tabindex:"-1"};
  extendedFormFieldAttributes = { "aria-hidden": true };
}
else {
  extendedFormElementAttributes = {...attributes};
  extendedFormFieldAttributes = {};
}
---
<div class={classes} {...extendedFormFieldAttributes}>
  <label for={id} class="c-form-field__label">
    <span class="inline-block">{label}</span>
    {required && <span aria-hidden="true" class="c-required-field-indicator">*</span>}
  </label>
  <div class="c-form-field__input-wrapper">
    {
      fieldType === "textarea" ? (
        <textarea
          id={id}
          name={name}
          rows={rows}
          class={inputClasses}
          data-error-messages={errorMessages}
          data-error-message-id={errorMessageId}
          required={required}
          {...extendedFormElementAttributes}
        ></textarea>
      ) : (
        <input
          id={id}
          name={name}
          type={inputType}
          class={inputClasses}
          data-error-messages={errorMessages}
          data-error-message-id={errorMessageId}
          required={required}
          {...extendedFormElementAttributes}
        />
      )
    }
    <span
      id={errorMessageId}
      aria-live="polite"
      class="c-form-field__error-message"
    ></span>
    <Icon type="check-circle" aria-hidden="true" class={successIndicatorClasses} />
  </div>
</div>
