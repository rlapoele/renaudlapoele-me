---
import { combineCssClasses } from "@scripts/combineCssClasses.ts";

type Props = { class?: string; };

const {class: className } = Astro.props as Props;
const baseClasses = "c-badge";
//  "inline-flex items-center justify-center rounded-full px-4 py-2 text-sm font-medium bg-paint-badge/70 text-ink-secondary shadow-sm ring-1 ring-line-subtle";
const classes = combineCssClasses(baseClasses, className);
---
<span class={classes}>
  <slot />
</span>
