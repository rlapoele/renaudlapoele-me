} as const;

type IconType = keyof typeof ICON_PATHS;

type Props = {
  type: IconType;
  class?: string;
  isDecorative?: boolean;
  isStandalone?: boolean;
  isLinkWrapped?: boolean;
  title?: string;
  attributes?: Record<string, unknown>;
};

const {
  type,
  class: className,
  isDecorative = true,
  isStandalone = false,
  isLinkWrapped = false,
  title,
  ...attributes
} = Astro.props as Props;

if (!isDecorative) {
  if ((!isStandalone && !isLinkWrapped) || (isStandalone && isLinkWrapped)) {
    throw new Error('Icon: non decorative icons must either be standalone OR wrapped by a link.');
  }
  if(isStandalone && !title) {
    throw new Error('Icon: standalone non decorative icons must have a title.');
  }
}

const baseClasses = "";
const classes = combineCssClasses(baseClasses, className);
const path = ICON_PATHS[type];
---
{
  (isDecorative || isLinkWrapped) &&
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class={classes}
      aria-hidden="true"
      {...attributes}
    >
      <path stroke-linecap="round" stroke-linejoin="round" d={path}/>
    </svg>
}
{
  !isDecorative && isStandalone &&
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
    class={classes}
    role="img"
    {...attributes}
  >
    <title>{title}</title>
    <path stroke-linecap="round" stroke-linejoin="round" d={path}/>
  </svg>
}



