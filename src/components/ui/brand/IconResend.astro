---
import {combineCssClasses} from "@scripts/shared/combineCssClasses.ts";

type Props = {
  class?: string;
  title?: string;
  attributes?: Record<string, unknown>;
}

const {
  class: className = "",
  title = "Resend Logo",
  ...attributes
} = Astro.props as Props;

const baseCssClasses = "";
const classes = combineCssClasses(baseCssClasses, className);
---
