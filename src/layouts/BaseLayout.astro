---
import "@styles/global.css";

import type { NavBarItemType } from "@content/config/Types";
import type { LocaleType } from "@content/i18n/locale";
import type { ResumeType } from "@content/i18n/resume/Types";

import { SUPPORTED_LOCALES } from "@content/i18n/locale";
import { getResumeData } from "@content/i18n/resume";
import { config } from "@content/config";
import { SITE_URL } from "astro:env/server";
import { normalizeSiteUrl, buildAbsoluteUrl, prefixHashUrl } from "@scripts/server/configUtils.ts";

import Header from "@components/layout/Header/Header.astro";
import Footer from "@components/layout/Footer.astro";
import JsonLd from "@components/seo/JsonLd.astro";

interface Props {
  locale: LocaleType;
  pageTitle?: string;
  pageDescription?: string;
  canonicalPath?: string;
  navItemUrlPrefix?: string;
  robots?: string;
  themeColor?: string;
}

const {
  locale,
  pageTitle,
  pageDescription = "Resume landing page for Renaud Lapoele, Senior Front-End Engineer with UX/UI and product leadership experience.",
  canonicalPath,
  navItemUrlPrefix = "",
  robots = "index, follow",
  themeColor = "#1c1917",
} = Astro.props;
const resume: ResumeType = getResumeData(locale);
const pageMetadata = resume.content.pageMetadata;
const openGraph = pageMetadata.openGraph;
const siteUrl = normalizeSiteUrl(SITE_URL);

const localizedResumeUrls = {
  [SUPPORTED_LOCALES.EN]: buildAbsoluteUrl(siteUrl, "/"),
  [SUPPORTED_LOCALES.FR]: buildAbsoluteUrl(siteUrl, "/fr"),
  "x-default": buildAbsoluteUrl(siteUrl, "/"),
};
const canonicalUrl = canonicalPath ? buildAbsoluteUrl(siteUrl, canonicalPath) : undefined;
const shouldRenderOpenGraph = Boolean(canonicalUrl);
const openGraphTitle = openGraph.title || pageTitle;
const openGraphDescription = openGraph.description || pageDescription;
const openGraphUrl = canonicalUrl ?? buildAbsoluteUrl(siteUrl, openGraph.url);
const openGraphImage = buildAbsoluteUrl(siteUrl, openGraph.image);
const pagePath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const pageUrl = buildAbsoluteUrl(siteUrl, pagePath);
const profilePageId = `${pageUrl}#profilepage`;

const navItemsData: NavBarItemType[] = config.header.navigation.items.map((item) => ({
  ...item,
  url: prefixHashUrl(navItemUrlPrefix, item.url),
  items: item.items.map((subItem) => ({
    ...subItem,
    url: prefixHashUrl(navItemUrlPrefix, subItem.url),
  })),
}));

const jsonLdSchema = {
  ...pageMetadata.jsonLdSchema,
  "@id": profilePageId,
  url: pageUrl,
};
---

<!DOCTYPE html>
<html lang={locale} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content={pageDescription}
    />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={themeColor} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && (
      <>
        <link rel="alternate" hreflang={SUPPORTED_LOCALES.EN} href={localizedResumeUrls[SUPPORTED_LOCALES.EN]} />
        <link rel="alternate" hreflang={SUPPORTED_LOCALES.FR} href={localizedResumeUrls[SUPPORTED_LOCALES.FR]} />
        <link rel="alternate" hreflang="x-default" href={localizedResumeUrls["x-default"]} />
      </>
    )}
    {shouldRenderOpenGraph && (
      <>
        <meta property="og:type" content={openGraph.type} />
        {openGraphTitle && <meta property="og:title" content={openGraphTitle} />}
        <meta property="og:description" content={openGraphDescription} />
        <meta property="og:url" content={openGraphUrl} />
        <meta property="og:image" content={openGraphImage} />
        <meta property="og:locale" content={openGraph.locale} />
        <meta property="og:locale:alternate" content={openGraph.alternateLocale} />
      </>
    )}
    {canonicalUrl && <JsonLd schema={jsonLdSchema} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <style>
      @font-face {
        font-family: "Urbanist";
        src: url("/fonts/Urbanist/Urbanist-VariableFont_wght.ttf") format("truetype-variations");
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Urbanist";
        src: url("/fonts/Urbanist/Urbanist-Italic-VariableFont_wght.ttf") format("truetype-variations");
        font-weight: 100 900;
        font-style: italic;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Lora";
        src: url("/fonts/Lora/Lora-VariableFont_wght.ttf") format("truetype-variations");
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Lora";
        src: url("/fonts/Lora/Lora-Italic-VariableFont_wght.ttf") format("truetype-variations");
        font-weight: 100 900;
        font-style: italic;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    </style>
  </head>

  <body>
    <div class="relative min-h-full">
      <div class="c-grid-overlay"></div>
      <div class="relative w-full">
        <a href="#main-content" class="c-skip-link">Skip to main content</a>
        <Header locale={locale} siteUrl={siteUrl} navItemsData={navItemsData} navItemLabels={resume.ui.header.navigation} settings={resume.ui.header.settings} />
        <main id="main-content" tabindex="-1" role="main">
          <slot />
        </main>
        <Footer class=""
                fullname={`${resume.data.personal.firstName} ${resume.data.personal.lastName}`}
                misc={resume.ui.misc}
                tagline={resume.content.footer.tagline}/>
      </div>
    </div>

    <script>
      import { setupInteractions } from "@scripts/client/interactions.ts";
      setupInteractions();
    </script>
  </body>
</html>
