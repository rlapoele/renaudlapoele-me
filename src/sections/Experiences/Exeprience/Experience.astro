---
import type {ExperienceItemType} from "@content/i18n/resume/Types.ts";
import {combineCssClasses} from "@scripts/shared/combineCssClasses.ts";
import Card from "@components/ui/Card.astro";
import ExperienceOrgRole from "@sections/Experiences/Exeprience/ExperienceOrgRole.astro";
import ExperienceDatesLocation from "@sections/Experiences/Exeprience/ExperienceDatesLocation.astro";
import ExperienceResponsibilities from "@sections/Experiences/Exeprience/ExperienceResponsibilities.astro";
import ExperienceSummary from "@sections/Experiences/Exeprience/ExperienceSummary.astro";

type Props = {
  experience: ExperienceItemType;
  class?: string;
};

const {
  experience,
  class: className = ""
} = Astro.props as Props;

const baseCssClasses = "";
const classes = combineCssClasses(baseCssClasses, className);
---
<Card class={classes}>
  { experience.startDate &&
    <ExperienceDatesLocation
      startDateLabel={experience.startDate?.label as string}
      endDateLabel={experience.endDate?.label as string}
      location={experience.location as string}
      class="mbe-4"
    />
  }
  <ExperienceOrgRole
    org={experience.company}
    role={experience.role as string}
    class="mbe-4"
  />
  <ExperienceSummary
    summary={experience.summary as string}
  />
  <ExperienceResponsibilities
    responsibilities={experience.responsibilities as string[]}
  />
</Card>
