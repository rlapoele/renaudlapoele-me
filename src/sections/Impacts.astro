---
import Container from "@components/ui/Container.astro";
import Card from "@components/ui/Card.astro";
import type {SelectedImpactType} from "@content/i18n/resume/Types.ts";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Bullet from "@components/ui/Bullet.astro";

type Props = { content: SelectedImpactType, sectionLabel: string };
const { content, sectionLabel } = Astro.props as Props;
---
<section id="impacts" class="l-section">
  <Container class="grid gap-8 lg:grid-cols-[0.95fr_2fr] items-start">
    <SectionHeading label={sectionLabel} title={content.title} />
    <div class="space-y-5">
      {content.items.map((item) => (
        <Card>
          <h4 class="text-2xl font-semibold">{item.title}</h4>
          <p class="mt-3 max-w-3xl leading-relaxed text-ink-tertiary">
            {item.description}
          </p>
          <ul class="mt-6 space-y-2 text-sm text-ink-secondary">
            {item.highlights.map((highlight) => (
              <li class="flex items-center gap-3">
                <Bullet class="mbs-0.5"/>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        </Card>
      ))}
    </div>
  </Container>
</section>

