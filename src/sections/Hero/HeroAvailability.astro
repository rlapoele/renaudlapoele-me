---
import { combineCssClasses } from "@scripts/shared/combineCssClasses.ts";
import Badge from "@components/ui/Badge.astro";

type Props = {
  class?: string;
  attributes?: Record<string, string>;
};

const {
  class: className = "",
  ...attributes
} = Astro.props as Props;

const baseClasses = "mbe-10";
const classes = combineCssClasses(baseClasses, className);
---
<div class={classes} {...attributes}>
  <p class="">
    <span class="text-ink-primary">Available from <strong class="underline decoration-2 underline-offset-4 decoration-dotted">September 2026</strong></span>
    <span class="text-line-default ms-1 me-1">/</span>
    <span class="text-ink-tertiary">Open to permanent or contract opportunities</span></p>
</div>
