---
import type {LocaleType} from "../../.archives/common/locale/types.ts";
import type { ExperienceLabelType} from "../../.archives/ui/experience/types.ts";
import type { ResumeType } from "../../.archives/data/resume/types.ts";
import {getExperienceLabel} from "../../.archives/ui/experience";

const { resume, locale } = Astro.props as { resume: ResumeType, locale: LocaleType };
const experienceLabel: ExperienceLabelType = getExperienceLabel(locale);
---

<section class="space-y-10">
  <header class="mt-12">
    <h2 class="text-2xl font-semibold capitalize text-amber-600">{experienceLabel}</h2>
  </header>

  <div class="space-y-8">
      {resume.experience.roles.map((job) => (
          <article class="space-y-3 border-b border-gray-200 pb-6 last:border-none dark:border-gray-700">

            <!-- Role -->
            <h3 class="text-lg font-semibold">
                {
                  job.roles.map(
                    (role: string, index: number, roles: string[]) => (
                      (index + 1 < roles.length) ? <span>{role} / </span>: <span>{role}</span>
                    )
                  )
                }
            </h3>

            <!-- Meta -->
            <h4 class="text-md text-gray-500 dark:text-gray-400">
              {job.company && job.company}{job.location && `, ${job.location}`}{job.period && `, ${job.period}`}
            </h4>

            <!-- Highlights -->
            <ul class="space-y-2">
                {job.highlights.map((highlight) => (
                    <li class="flex items-baseline gap-3">
                      <span class="mt-1.5 h-1.5 shrink-0 w-1.5 rounded-full bg-gray-400 dark:bg-gray-500"></span>
                      <span class="text-sm leading-relaxed">{highlight}</span>
                    </li>
                ))}
            </ul>

          </article>
      ))}
  </div>
</section>
