---
import type { SnapshotType } from "@content/i18n/resume/Types";
import Card from "@components/ui/Card.astro";
import Section from "@components/layout/Section.astro";
import Transformer from "@components/ui/Transformer.astro";

type Props = { content: SnapshotType, sectionLabel: string};

const { content, sectionLabel } = Astro.props as Props;

---
<Section id="snapshot" label={sectionLabel} title={content.title} bodyClass="l-auto-grid">
  {content.items.map((item) => (
    <Card variant="default" as="div">
      <h5 class="text-lg font-semibold mbe-4"><Transformer text={item.label}/></h5>
      <p class="text-sm leading-6 text-ink-primary">
        {item.description}
      </p>
    </Card>
  ))}
</Section>
