---
import type {SelectedWorkType} from "@content/i18n/resume/Types";
import Card from "@components/ui/Card.astro";
import Tag from "@components/ui/Tag.astro";
import Section from "@components/layout/Section.astro";
import Bullet from "@components/ui/Bullet.astro";
import Transformer from "@components/ui/Transformer.astro";
import Icon from "@components/ui/Icon.astro";
import IconGitHub from "@components/ui/brand/IconGitHub.astro";

type Props = { content: SelectedWorkType, sectionLabel: string };
const { content, sectionLabel} = Astro.props as Props;
---
<Section id="works" label={sectionLabel} title={content.title} bodyClass="l-auto-grid l-auto-grid--col-min-20">
  {content.items.map((project) => (
    <Card variant="feature" isInteractive>
      <p class="text-md font-semibold dark:font-medium uppercase tracking-wider text-accent-primary">
        {project.type}
      </p>
      <h5 class="mt-3 text-xl leading-tight font-semibold">
        <Transformer text={project.name} mustTrimSeparator={false} sourceItemSeparator=" / " class="text-ink-tertiary/50 font-normal"/>
      </h5>
      <p class="mt-4 leading-relaxed text-ink-tertiary">
        {project.description}
      </p>
      <ul class="mt-6 space-y-2 text-sm text-ink-primary">
        {project.highlights.map((highlight) => (
          <li class="flex items-center gap-2.5">
            <Bullet class="mbs-0.5"/>
            <span>{highlight}</span>
          </li>
        ))}
      </ul>
      <div class="mt-7 flex flex-wrap gap-2">
        {project.tags.map((tag) => (
          <Tag>{tag}</Tag>
        ))}
      </div>
      {
        !!project.repository &&
        <p class="mt-7 text-sm"><a class="c-text-link text-ink-secondary hover:text-accent-primary inline-flex items-center gap-2" href={project.repository.url} title={project.repository.title} target="_blank" rel="noopener"><IconGitHub class="inline-block size-5"/>{project.repository.url}</a></p>
      }
    </Card>
  ))}
</Section>
