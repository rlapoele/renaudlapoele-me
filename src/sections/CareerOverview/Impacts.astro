---
import type {SelectedImpactType} from "@content/i18n/resume/Types.ts";
import Card from "@components/ui/Card.astro";
import Section from "@components/layout/Section.astro";
import Bullet from "@components/ui/Bullet.astro";

type Props = { content: SelectedImpactType, sectionLabel: string };
const { content, sectionLabel } = Astro.props as Props;
---
<Section id="impacts" label={sectionLabel} title={content.title} bodyClass="space-y-5">
  {content.items.map((item) => (
    <Card>
      <h5 class="text-xl font-semibold">{item.title}</h5>
      <p class="mt-3 max-w-3xl leading-relaxed text-ink-tertiary">
        {item.description}
      </p>
      <ul class="mt-6 space-y-2 text-sm text-ink-secondary">
        {item.highlights.map((highlight) => (
          <li class="flex items-center gap-3">
            <Bullet class="mbs-0.5"/>
            <span>{highlight}</span>
          </li>
        ))}
      </ul>
    </Card>
  ))}
</Section>
