---
import type { ContactType, ContactUIType} from "@content/i18n/resume/Types";

import { combineCssClasses } from "@scripts/shared/combineCssClasses.ts";
import { DOM_ELEMENT_IDS } from "@scripts/shared/contactForm/domElementIds.ts";
import { CONTACT_FORM_INPUT_MIN_MAX_LENGTHS } from "@scripts/shared/contactForm/validation.ts";
import {objectKeyValueArrayToString} from "@scripts/shared/objectKeyValueArrayToString.ts";
import {objectToObjectArray} from "@scripts/shared/objectToObjectArray.ts";

import Container from "@components/layout/Container.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Card from "@components/ui/Card.astro";
import Spinner from "@components/ui/Spinner.astro";
import FormField from "@components/ui/FormField.astro";
import Toasts from "@components/ui/Toasts.astro";

type Props = {
  locale: string,
  content: ContactType,
  contentLabels: ContactUIType,
  class?: string,
};

const {
  locale,
  content,
  contentLabels,
  class: className = ''
} = Astro.props as Props;

const baseCssClasses = 'l-section print:hidden';
const classes = combineCssClasses(baseCssClasses, className);

const minLengthName = CONTACT_FORM_INPUT_MIN_MAX_LENGTHS.NAME.MIN;
const maxLengthName = CONTACT_FORM_INPUT_MIN_MAX_LENGTHS.NAME.MAX;
const minLengthEmail = CONTACT_FORM_INPUT_MIN_MAX_LENGTHS.EMAIL.MIN;
const maxLengthEmail = CONTACT_FORM_INPUT_MIN_MAX_LENGTHS.EMAIL.MAX;
const minLengthMessage = CONTACT_FORM_INPUT_MIN_MAX_LENGTHS.MESSAGE.MIN;
const maxLengthMessage = CONTACT_FORM_INPUT_MIN_MAX_LENGTHS.MESSAGE.MAX;

const initialSubmitButtonTextLabel = contentLabels. form.controls.submitButton.labels.send;
---
<div>
  <Container><h2 id="contact" tabindex="-1" class="c-section-group-heading mbe-10">{contentLabels.label}</h2></Container>

<section class={ classes }>
  <Container>
    <Card variant="section" padding="xl">
      <div class="grid gap-10 lg:gap-20 lg:grid-cols-[0.95fr_1.35fr]">
        <div>
          <SectionHeading title={content.title} label={contentLabels.cardLabel} isHeaderStatic={true}/>
          <p class="mt-4 max-w-lg leading-relaxed text-ink-secondary">{content.description}</p>
          <p class="mt-6 text-sm text-ink-tertiary">{content.note}</p>
        </div>

        <form
          novalidate
          id={DOM_ELEMENT_IDS.CONTACT_FORM}
          aria-label={contentLabels.form.ariaLabel}
          data-notification-messages={objectKeyValueArrayToString(objectToObjectArray(contentLabels.form.notifications))}
        >
          <fieldset id={DOM_ELEMENT_IDS.CONTACT_FORM_FIELDSET} class="grid gap-8">

            <p class="flex items-center justify-end gap-1 text-xs text-ink-tertiary"><span aria-hidden="true" class="c-required-field-indicator">*</span>{contentLabels.form.requiredFieldMessage}</p>

            <input
              id={DOM_ELEMENT_IDS.CONTACT_FORM_INPUT_TOKEN}
              type="hidden"
              value=""
              name="token"
            />

            <input
              id={DOM_ELEMENT_IDS.CONTACT_FORM_INPUT_LOCALE}
              type="hidden"
              value={locale}
              name="locale"
              data-error-messages={objectKeyValueArrayToString(objectToObjectArray(contentLabels.form.inputs.locale.errorMessages))}
              data-error-message-id={DOM_ELEMENT_IDS.CONTACT_FORM_ERROR_MESSAGE_LOCALE}
            />
            <span id={DOM_ELEMENT_IDS.CONTACT_FORM_ERROR_MESSAGE_LOCALE} class="hidden"></span>

            <div class="grid gap-x-4 gap-y-8 2xl:grid-cols-2">

              <FormField
                id={DOM_ELEMENT_IDS.CONTACT_FORM_INPUT_NAME}
                name="name"
                label={contentLabels.form.inputs.name.label}
                inputType="text"
                autocomplete="name"
                placeholder={contentLabels.form.inputs.name.placeholder}
                errorMessages={objectKeyValueArrayToString(objectToObjectArray(contentLabels.form.inputs.name.errorMessages))}
                errorMessageId={DOM_ELEMENT_IDS.CONTACT_FORM_ERROR_MESSAGE_NAME}
                minlength={minLengthName}
                maxlength={maxLengthName}
                required
              />

              <FormField
                id={DOM_ELEMENT_IDS.CONTACT_FORM_INPUT_EMAIL}
                name="email"
                label={contentLabels.form.inputs.email.label}
                inputType="email"
                autocomplete="email"
                placeholder={contentLabels.form.inputs.email.placeholder}
                errorMessages={objectKeyValueArrayToString(objectToObjectArray(contentLabels.form.inputs.email.errorMessages))}
                errorMessageId={DOM_ELEMENT_IDS.CONTACT_FORM_ERROR_MESSAGE_EMAIL}
                minlength={minLengthEmail}
                maxlength={maxLengthEmail}
                required
              />

            </div>

            <FormField
              id={DOM_ELEMENT_IDS.CONTACT_FORM_INPUT_SUBJECT}
              name="subject"
              label={contentLabels.form.inputs.subject.label}
              inputType="text"
              autocomplete="off"
              placeholder={contentLabels.form.inputs.subject.placeholder}
              errorMessages={objectKeyValueArrayToString(objectToObjectArray(contentLabels.form.inputs.subject.errorMessages))}
              errorMessageId={DOM_ELEMENT_IDS.CONTACT_FORM_ERROR_MESSAGE_SUBJECT}
              required
              isHoneyPot={true}
            />

            <FormField
              id={DOM_ELEMENT_IDS.CONTACT_FORM_INPUT_MESSAGE}
              name="message"
              label={contentLabels.form.inputs.message.label}
              fieldType="textarea"
              rows={7}
              autocomplete="off"
              placeholder={contentLabels.form.inputs.message.placeholder}
              errorMessages={objectKeyValueArrayToString(objectToObjectArray(contentLabels.form.inputs.message.errorMessages))}
              errorMessageId={DOM_ELEMENT_IDS.CONTACT_FORM_ERROR_MESSAGE_MESSAGE}
              minlength={minLengthMessage}
              maxlength={maxLengthMessage}
              required
            />

            <div class="flex flex-wrap items-center gap-4 pt-2">
              <button id={DOM_ELEMENT_IDS.CONTACT_FORM_BUTTON_SUBMIT}
                      type="submit"
                      class="c-button gap-x-2"
                      data-text-labels={objectKeyValueArrayToString(objectToObjectArray(contentLabels.form.controls.submitButton.labels))}>
                <Spinner dataSize="md"/><span id={DOM_ELEMENT_IDS.CONTACT_FORM_SUBMIT_BUTTON_TEXT_LABEL}>{initialSubmitButtonTextLabel}</span>
              </button>
            </div>
          </fieldset>
        </form>

      </div>
    </Card>

  </Container>
</section>
</div>
