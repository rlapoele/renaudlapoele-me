---
import {combineCssClasses} from "@scripts/shared/combineCssClasses.ts";
type Props = {
  orgOrCert: string
  roleOrField: string
  class?: string
}

const {
  orgOrCert ,
  roleOrField,
  class: className = ""
} = Astro.props as Props;

const baseCssClasses = "text-xl leading-tight font-semibold";
const classes = combineCssClasses(baseCssClasses, className);
---
<h5 class={classes}><span class="text-ink-tertiary">{orgOrCert}</span><span class="text-ink-tertiary/50 font-normal"> - </span><span>{roleOrField}</span></h5>
