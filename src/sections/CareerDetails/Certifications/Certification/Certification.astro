---
import type {CertificationItemType} from "@content/i18n/resume/Types.ts";
import { combineCssClasses } from "@scripts/shared/combineCssClasses.ts";
import OrgOrCertRoleOrField from '@sections/CareerDetails/shared/OrgOrCertRoleOrField.astro';
import DatesLocation from "@sections/CareerDetails/shared/DatesLocation.astro";
import Card from "@components/ui/Card.astro";
import Icon from "@components/ui/Icon.astro";

type Props = {
  certification: CertificationItemType
  class?: string
}

const {
  certification,
  class: className = ""
} = Astro.props as Props;

const baseCssClasses = "";
const classes = combineCssClasses(baseCssClasses, className);

const institution = certification.institution;
const name = certification.name;
const fieldOfStudy = certification.fieldOfStudy;
const startDateLabel: string = certification.startDate?.label ?? ""
const endDateLabel: string = certification.endDate?.label ?? "";

---
<Card class={classes}>
  <DatesLocation class="mbe-3" startDateLabel={startDateLabel} endDateLabel={endDateLabel} location="" />
  <OrgOrCertRoleOrField class="mbe-4 leading-tight" orgOrCert={institution} roleOrField={fieldOfStudy} />
  <p class="leading-relaxed text-ink-primary"><a class="c-text-link underline-offset-4" href="">{name}<Icon type="external-link" class="size-4 inline-block ms-1 mbe-0.5" isDecorative={true}/></a></p>
</Card>
