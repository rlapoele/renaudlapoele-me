---
import type {ExperienceItemType, ExperienceSkillGroupType} from "@content/i18n/resume/Types.ts";
import type {ExperienceSectionLabelsType} from "@sections/CareerDetails/Types.ts";
import {combineCssClasses} from "@scripts/shared/combineCssClasses.ts";
import Card from "@components/ui/Card.astro";
import ExperienceOrgRole from "@sections/CareerDetails/Experiences/Experience/ExperienceOrgRole.astro";
import ExperienceDatesLocation from "@sections/CareerDetails/Experiences/Experience/ExperienceDatesLocation.astro";
import ExperienceResponsibilities from "@sections/CareerDetails/Experiences/Experience/ExperienceResponsibilities.astro";
import ExperienceSummary from "@sections/CareerDetails/Experiences/Experience/ExperienceSummary.astro";
import ExperienceSkills from "@sections/CareerDetails/Experiences/Experience/ExperienceSkills.astro";
import ExperienceKeyFocuses from "@sections/CareerDetails/Experiences/Experience/ExperienceKeyFocuses.astro";



type Props = {
  id: string;
  sectionLabels: ExperienceSectionLabelsType;
  experience: ExperienceItemType;
  class?: string;
};

const {
  id,
  sectionLabels,
  experience,
  class: className = ""
} = Astro.props as Props;

const baseCssClasses = "";
const classes = combineCssClasses(baseCssClasses, className);
const titleId = `${id}-title`;
const metaId = `${id}-meta`;
const summaryId = `${id}-summary`;
const ariaDescribedBy = !!experience.startDate ? `${metaId} ${summaryId}` : summaryId;
---
<Card class={classes} aria-labelledby={titleId} aria-describedby={ariaDescribedBy}>
  { experience.startDate &&
    <ExperienceDatesLocation
      id={metaId}
      startDateLabel={experience.startDate?.label as string}
      endDateLabel={experience.endDate?.label as string}
      location={experience.location as string}
      class="mbe-3"
    />
  }
  <ExperienceOrgRole
    id={titleId}
    org={experience.company}
    role={experience.role as string}
    class="mbe-4"
  />
  <ExperienceSummary
    id={summaryId}
    summary={experience.summary as string}
  />
  <ExperienceResponsibilities
    responsibilities={experience.responsibilities as string[]}
  />
  {
    !!experience.keyFocus &&
    <ExperienceKeyFocuses
      class="mbs-10"
      label={sectionLabels.keyFocusLabel}
      keyFocus={experience.keyFocus as string}
    />
  }
  {
    !!experience.skillGroups.length &&
    <ExperienceSkills
      class="mbs-10"
      label={sectionLabels.skillsLabel}
      skillGroups={experience.skillGroups as ExperienceSkillGroupType[]} />
  }
</Card>
