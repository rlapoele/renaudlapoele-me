---
import OrgOrCertRoleOrField from '@sections/CareerDetails/shared/OrgOrCertRoleOrField.astro';
type Props = {
  id: string;
  org: string;
  role: string;
  class?: string;
}

const {
  id,
  org ,
  role,
  class: className = ""
} = Astro.props as Props;

---
<OrgOrCertRoleOrField id={id} class={className} orgOrCert={org} roleOrField={role} />
