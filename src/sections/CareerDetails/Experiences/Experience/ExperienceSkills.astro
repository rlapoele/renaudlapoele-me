---
import { combineCssClasses } from "@scripts/shared/combineCssClasses.ts";
import type { ExperienceSkillGroupType } from "@content/i18n/resume/Types.ts";
import Transformer from "@components/ui/Transformer.astro";
import Tag from "@components/ui/Tag.astro";

type Props = {
  label: string;
  skillGroups: ExperienceSkillGroupType[];
  class?: string;
};

const {
  label,
  skillGroups,
  class: className= ""
} = Astro.props as Props;

const baseCssClasses = "";
const classes = combineCssClasses(baseCssClasses, className);
---
<div class={classes}>
  <h6 class="leading-tight text-accent-primary text-sm font-semibold dark:font-medium uppercase tracking-wider mbe-3">{label}</h6>
  {
    skillGroups.map(
      (skillGroup) => {
        return (
          <p class="block font-medium text-ink-tertiary tracking-wider uppercase text-xs mbe-2">
            <Transformer text={skillGroup.name} mustTrimSeparator={false} sourceItemSeparator=" / " class="text-ink-tertiary"/>
          </p>
          <div class="flex flex-wrap gap-2 mbe-6 last:mbe-0">
            {skillGroup.skills.map((skill) => (
              <Tag>{skill}</Tag>
            ))}
          </div>
        );
      }
    )
  }
</div>
