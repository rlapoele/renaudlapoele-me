---
import { combineCssClasses } from "@scripts/shared/combineCssClasses.ts";
import type { ExperienceSkillGroupType } from "@content/i18n/resume/Types.ts";
import Transformer from "@components/ui/Transformer.astro";
import Bullet from "@components/ui/Bullet.astro";

type Props = {
  skillGroups: ExperienceSkillGroupType[]
  class?: string
};

const {
  skillGroups,
  class: className= ""
} = Astro.props as Props;
const baseCssClasses = "";
const classes = combineCssClasses(baseCssClasses, className);
---
<div class={classes}>
  <h6 class="leading-6 text-accent-primary text-sm font-semibold dark:font-medium uppercase tracking-wider mbe-4">Skills</h6>
  {
    skillGroups.map(
      (skillGroup) => {
        return (
          <p class="block text-ink-tertiary tracking-wider uppercase text-xs mbe-3">
          <Transformer text={skillGroup.name} mustTrimSeparator={false} sourceItemSeparator=" / " class="text-ink-tertiary/50"/></p>
          <p class="text-sm mbe-8 last:mbe-0 flex items-baseline justify-start gap-3"><span class="pbe-0.5"><Bullet /></span>
          {
            skillGroup.skills.map(
              (skill: string, skillIndex: number, skillArray: string[]) => ( skillIndex < (skillArray.length - 1) ? <Fragment>{skill}, </Fragment> : <Fragment>{skill}</Fragment> )
            )
          }
          </p>
        );
      }
    )
  }
</div>
