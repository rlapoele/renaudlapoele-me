---
import type {ExperienceType} from "@content/i18n/resume/Types.ts";
import type {ExperienceSectionLabelsType} from "@sections/CareerDetails/Types.ts";
import Experience from "@sections/CareerDetails/Experiences/Experience/Experience.astro";
import Section from "@components/layout/Section.astro";

type Props = {
  content: ExperienceType,
  sectionLabels: ExperienceSectionLabelsType
};
const {
  content,
  sectionLabels
} = Astro.props as Props;
---
<Section id="experience" label={sectionLabels.sectionLabel} title={content.title} bodyClass="space-y-5">
  {
    content.items.map((experience) => <Experience experience={experience} sectionLabels={sectionLabels} />)
  }
</Section>
